[DEFAULT]
bantime  = 3600
findtime = 60
maxretry = 10
backend  = auto
ignoreip = 127.0.0.1/8 ::1

[nginx-limit-req]
enabled  = true
port     = http
filter   = nginx-limit-req
logpath  = /var/log/nginx/access.log
maxretry = 10
findtime = 60
bantime  = 3600
action   = iptables[name=nginx-limit, chain=DOCKER-USER, port="80", protocol=tcp]